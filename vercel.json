{
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/app.js",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
            ]
        },
        {
            "source": "/audio-engine.js",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
            ]
        },
        {
            "source": "/style.css",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        }
    ]
}
